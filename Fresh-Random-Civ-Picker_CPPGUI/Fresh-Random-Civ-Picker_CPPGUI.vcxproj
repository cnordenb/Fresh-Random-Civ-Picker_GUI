  <!-- The program loads its images from the exe's own folder, so every build copies them next to the exe. -->
  <Target Name="CopyImagesToOutDir" AfterTargets="Build">
    <ItemGroup>
      <ProgramImage Include="$(ProjectDir)images\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(ProgramImage)" DestinationFiles="@(ProgramImage->'$(OutDir)images\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
  <!-- data.json (the editions, DLCs and civs) and the civ jingles named after them are read from the exe's
       folder as well. -->
  <Target Name="CopyProgramDataToOutDir" AfterTargets="Build">
    <ItemGroup>
      <ProgramData Include="$(ProjectDir)data.json" />
      <ProgramJingle Include="$(ProjectDir)sounds\civ_jingles\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(ProgramData)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(ProgramJingle)" DestinationFiles="@(ProgramJingle->'$(OutDir)sounds\civ_jingles\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
